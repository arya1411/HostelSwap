# Copy to .env and replace these classroom demo values before sharing a deployment.
POSTGRES_DB=hostelswap
POSTGRES_USER=hostelswap
# URL-encode reserved characters if changing the database password (it is used in DATABASE_URL).
POSTGRES_PASSWORD=classroom-db-change-me
JWT_SECRET=classroom-only-replace-this-secret-with-64-random-characters
# Comma-separated exact domains, without @. Subdomains must be listed explicitly.
COLLEGE_EMAIL_DOMAINS=college.edu
FRONTEND_PORT=8080
SEED_DEMO=true
DEMO_PASSWORD=CampusSwap2026!
